# Database Configuration
MONGO_URI=mongodb://localhost:27017/cognizenx
# MONGO_URL is an alternative name for MONGO_URI (both work)

# Server Configuration
PORT=6000
NODE_ENV=development

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Semantic dedup for generated questions (same category + subDomain)
SEMANTIC_SIMILARITY_THRESHOLD=0.85
EMBEDDING_MODEL=text-embedding-3-small

# Email Configuration (for password reset)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# Reset Password URL (optional, defaults to current host)
RESET_URL=http://localhost:6000/reset-password

# Rate limiting (per 15 minutes)
# Auth routes (/api/auth/*) are always limited per IP.
# Logged-in API calls are limited per account (Bearer token); anonymous calls per IP.
AUTH_RATE_LIMIT_MAX=15
GLOBAL_RATE_LIMIT_MAX_ANON=80
GLOBAL_RATE_LIMIT_MAX_USER=400

# Generate a secure random token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-secure-random-token-here

# Promote an existing user to admin (optional; script also accepts CLI email arg):
#   node scripts/script_P0/promote-admin.js you@example.com
ADMIN_BOOTSTRAP_EMAIL=

# P0.2 internal test accounts (behavioural data excluded from demand/analytics by default)
#   node scripts/script_P0/flag-and-purge-internal-data.js
#   node scripts/script_P0/flag-and-purge-internal-data.js --confirm --confirm-production
#   node scripts/script_P0/set-internal-user.js you@example.com
#   node scripts/script_P0/set-internal-user.js you@example.com --external

# PostHog (P0.3) — same project token as the mobile app; host must match region (US or EU)
POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
POSTHOG_HOST=https://us.i.posthog.com
# Optional: person deletion on account delete (also used in P0.9)
# POSTHOG_PERSONAL_API_KEY=phx_...
# POSTHOG_PROJECT_ID=624973

# P0.6A — minimum client version (empty = allow all, including the store /api clients)
# When set, clients must send X-App-Version >= this value or receive 426 FORCE_UPDATE.
# Leave unset until the P0 store build is the minimum you want to support.
# MIN_SUPPORTED_APP_VERSION=3.0.0

# Sentry (P0.7) — mindmitra-api project DSN
SENTRY_DSN=https://your_key@o000.ingest.us.sentry.io/000
SENTRY_ENVIRONMENT=development
# Optional override for release tagging in production
# SENTRY_RELEASE=mindmitra-api@gitsha
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Force-enable GET /api/v1/debug-sentry even when NODE_ENV=production
# SENTRY_ENABLE_DEBUG_ROUTE=1


# Personalized quiz + demand-aware cron
FRESH_SLOTS_RATIO=0.7
FRESH_SLOTS_PER_QUIZ=7
USER_EXHAUSTION_RATIO=0.9
MAX_WEEKLY_PER_SUBDOMAIN=50
MAX_WEEKLY_TOTAL_QUESTIONS=500
CRON_CRITICAL_BATCH=40
CRON_HOT_BATCH=20
CRON_WARM_BATCH=10
CRON_EMPTY_BATCH=50
